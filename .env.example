NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_BRAND_NAME=APEX

# Persistence (optional). When unset, catalog uses the curated seed inventory.
DATABASE_URL=

# Admin. Required in production. Development fallback is documented in README.
ADMIN_PASSWORD=
ADMIN_SECRET=

# Virtual try-on. Use "mock" for the development preview provider.
TRYON_PROVIDER=mock
TRYON_API_URL=
TRYON_API_KEY=

# Optional LLM for query parsing only. Products still come from the catalog.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini

# Supplier credentials must be referenced by name, never hardcoded.
# SUPPLIER_EUROPARTS_API_KEY=
