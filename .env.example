NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_BRAND_NAME=APEX

# Persistence (optional). When unset, catalog uses the curated seed inventory.
DATABASE_URL=

# Admin. Required in production. Development fallback is documented in README.
ADMIN_PASSWORD=
ADMIN_SECRET=

# Virtual try-on generates a photo of the customer's car with the part fitted
# (grille installed, car lowered, etc.) — not a PNG overlay.
# Uses OpenAI image edits when OPENAI_API_KEY is set. Optional custom provider:
TRYON_API_URL=
TRYON_API_KEY=
TRYON_IMAGE_MODEL=

# Also used for query parsing. Products still come from the catalog.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini

# Stripe Checkout. Secret key stays on the server — never in the client or git.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Supplier credentials must be referenced by name, never hardcoded.
# SUPPLIER_EUROPARTS_API_KEY=
